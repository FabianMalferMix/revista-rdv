# Plantilla de PRODUCCIÓN. En el host de producción, copia a `.env` y pon valores REALES:
#
#   cp .env.prod.example .env   &&   editar .env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Con DJANGO_DEBUG=0 el arranque SE RECHAZA si falta cualquiera de los valores
# obligatorios, si conserva un placeholder, si la SECRET_KEY es débil (<50 caracteres
# o <5 distintos), si ALLOWED_HOSTS trae el comodín '*' o si algún origen de CSRF no
# es https://. Los secretos van VACÍOS a propósito: así el guard los detecta aunque
# se olvide sustituirlos (ver backend/config/envguard.py).

# ── Django ────────────────────────────────────────────────
# Genera una clave nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=revista.tudominio.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://revista.tudominio.cl
# Activos por defecto con DEBUG=0 (opt-out explícito si hiciera falta):
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# Rotación de clave con solapamiento (claves previas separadas por coma):
# DJANGO_SECRET_KEY_FALLBACKS=clave-anterior

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=resenas
POSTGRES_USER=resenas
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis (autenticado en producción) ─────────────────────
# Con REDIS_PASSWORD definido, las URLs de Celery incluyen la auth automáticamente.
# Obligatorio con DEBUG=0: sin él, broker y caché quedarían sin autenticar.
REDIS_PASSWORD=

# ── Límites de recursos de los contenedores ───────────────
# Aíslan un pico de un servicio del resto (sin ellos, un pico de `web` podía provocar
# que el OOM killer del host matase `db`). AJÚSTALOS a la RAM real de tu host: la suma
# debe quedar holgadamente por debajo. Los valores por defecto suman ~3 GB.
# WEB_MEM_LIMIT=768m
# WEB_CPUS=1.5
# WORKER_MEM_LIMIT=512m
# WORKER_CPUS=1.0
# BEAT_MEM_LIMIT=256m
# BEAT_CPUS=0.5
# DB_MEM_LIMIT=1g
# DB_CPUS=2.0
# REDIS_MEM_LIMIT=384m
# REDIS_CPUS=0.5
# PROXY_MEM_LIMIT=128m
# PROXY_CPUS=1.0
# Paralelismo de gunicorn (workers × hilos = peticiones concurrentes).
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4

# ── Respaldos ─────────────────────────────────────────────
BACKUP_DIR=/var/backups/resenas
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400
# Off-site cifrado y deduplicado (restic). Muy recomendado: un respaldo solo local
# NO protege ante la pérdida del host. Backend S3/BackBlaze/rclone según RESTIC_REPOSITORY.
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/mi-bucket-respaldos/resenas
# RESTIC_PASSWORD=CAMBIA-ESTO-clave-de-cifrado-del-repo-restic
# RESTIC_KEEP=30
# AWS_ACCESS_KEY_ID=...        # o las credenciales del backend que uses
# AWS_SECRET_ACCESS_KEY=...
# Alerta de fallo (dead-man's-switch): GET a la URL al terminar OK, a "<URL>/fail" si falla.
# BACKUP_PING_URL=https://hc-ping.com/tu-uuid

# ── Observabilidad (Sentry — opcional pero recomendado) ───
# Con SENTRY_DSN definido se captura error tracking (Django + Celery). Sin él, no
# se activa nada. Los logs salen en JSON con DEBUG=0 (agregables por un colector).
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# DJANGO_LOG_LEVEL=INFO

# ── Correo (newsletter / notificaciones) ──────────────────
EMAIL_HOST=smtp.tuproveedor.cl
EMAIL_PORT=587
EMAIL_HOST_USER=usuario
EMAIL_HOST_PASSWORD=secreto
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Reseñas <no-reply@tudominio.cl>
