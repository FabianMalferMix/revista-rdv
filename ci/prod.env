# El entorno del job prod-runtime del CI: el compose de producción tal cual, con DEBUG=0 y
# valores que solo valen aquí. El CI lo copia a .env, como se hace en el servidor con
# .env.prod.example, que es la plantilla de producción.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROJECT_NAME=resenas
APP_VERSION=ci

# Sin dominio, Caddy sirve por http; en el runner, en el 8080.
SITE_ADDRESS=:80
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
SITE_URL=https://localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
# Sin TLS delante, la redirección a https dejaría el sitio fuera de alcance.
DJANGO_SECURE_SSL_REDIRECT=0

DJANGO_SECRET_KEY=ci-prod-secret-Kx7mQ9vLpZ4wR8nT3bY6cF1jH5dG0sA2eU7oI4aN9qW
POSTGRES_PASSWORD=ci-strong-db-password
REDIS_PASSWORD=ci-strong-redis-password

# El CI corre sin Sentry: la falta de SENTRY_DSN va autorizada.
DJANGO_ALLOW_WEAKENED=SENTRY_DSN
DEFAULT_FROM_EMAIL=no-reply@ci.example.com
