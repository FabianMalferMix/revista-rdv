# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env

# ── Django ────────────────────────────────────────────────
# En producción (DJANGO_DEBUG=0) DEBES definir una SECRET_KEY propia: el valor
# de ejemplo se rechaza al arrancar.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=resenas
POSTGRES_USER=resenas
POSTGRES_PASSWORD=resenas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Celery / Redis ────────────────────────────────────────
# Dev: Redis sin auth. En producción define REDIS_PASSWORD (ver .env.prod.example);
# las URLs de Celery incluyen la contraseña automáticamente.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Respaldos (servicio "backup") ─────────────────────────
# Carpeta de destino; en producción apúntala a un disco respaldado o montaje externo.
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400

# ── Producción ────────────────────────────────────────────
# Usa .env.prod.example como plantilla del .env de producción (secretos, Redis auth,
# ALLOWED_HOSTS/CSRF obligatorios, HSTS/SSL, correo SMTP).
