# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env

# ── Django ────────────────────────────────────────────────
# En producción (DJANGO_DEBUG=0) DEBES definir una SECRET_KEY propia: el valor
# de ejemplo se rechaza al arrancar.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Las herramientas de desarrollo (backend/apps/devtools: seed_demo, datos_de_desarrollo…) se
# instalan con DJANGO_DEBUG=1. Con DEBUG apagado, DJANGO_DEV_TOOLS=1 las instala igual (sus
# comandos en la lista, su tabla en las migraciones), pero sus comandos siguen exigiendo DEBUG.
# DJANGO_DEV_TOOLS=0
# development si falta. docker-compose.prod.yml declara production, y ahí las herramientas de
# desarrollo no corren aunque DEBUG esté encendido.
# DJANGO_ENVIRONMENT=development
# Origen de las URL absolutas; en desarrollo vale http://localhost:8000 si no se define.
# SITE_URL=http://localhost:8000

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=resenas
POSTGRES_USER=resenas
POSTGRES_PASSWORD=resenas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Celery / Redis ────────────────────────────────────────
# Dev: Redis sin auth. En producción define REDIS_PASSWORD (ver .env.prod.example);
# las URLs de Celery incluyen la contraseña automáticamente.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Respaldos (servicio "backup") ─────────────────────────
# Carpeta de destino; en producción apúntala a un disco respaldado o montaje externo.
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400

# ── Producción ────────────────────────────────────────────
# Usa .env.prod.example como plantilla del .env de producción (secretos, Redis auth,
# ALLOWED_HOSTS/CSRF obligatorios, HSTS/SSL, correo SMTP).
