# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env

# ── Django ────────────────────────────────────────────────
# En producción (DJANGO_DEBUG=0) DEBES definir una SECRET_KEY propia: el valor
# de ejemplo se rechaza al arrancar.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=resenas
POSTGRES_USER=resenas
POSTGRES_PASSWORD=resenas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Celery / Redis ────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Respaldos (servicio "backup") ─────────────────────────
# Carpeta de destino; en producción apúntala a un disco respaldado o montaje externo.
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400

# ── Producción (opcional; se usan con DJANGO_DEBUG=0) ─────
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tudominio.cl
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# EMAIL_HOST=smtp.tuproveedor.cl
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=secreto
# DEFAULT_FROM_EMAIL=Reseñas <no-reply@tudominio.cl>
