# Los textos del panel que el proyecto escribe en lugar de los de Django: los del selector doble
# de las relaciones de varios a varios (admin/js/SelectFilter2.js). Django lee este catálogo
# después del suyo, y cada entrada de aquí manda sobre la suya con el mismo msgid.
#
# El selector pone en %s el rótulo del campo, en minúscula y en plural, de un género o del
# otro: «etiquetas», «participantes», «autores». Ningún texto empieza por él ni lleva un
# adjetivo o un pronombre que tenga que concordar con él. Los botones de una línea («Elegir
# todo») y las flechas no lo llevan: el panel esconde la segunda línea de un botón.
#
# Django lee la copia compilada, djangojs.mo, que se rehace con
#   msgfmt --check-format -o djangojs.mo djangojs.po
# y una prueba comprueba que dice lo mismo que este archivo. La regla del plural es la del
# catálogo de Django: con otra, cambiaría también la de sus demás textos.
msgid ""
msgstr ""
"Project-Id-Version: resenas\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: es\n"
"Plural-Forms: nplurals=3; plural=n == 1 ? 0 : n != 0 && n % 1000000 == 0 ? 1 : 2;\n"

#, javascript-format
msgid "Available %s"
msgstr "Lista de %s disponibles"

#, javascript-format
msgid ""
"Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr ""
"Para elegir %s, se marcan en esta lista y se pulsa la flecha «Elegir»."

#, javascript-format
msgid "Type into this box to filter down the list of available %s."
msgstr "Lo que se escribe en este cuadro filtra la lista de %s disponibles."

msgid "Choose all %s"
msgstr "Elegir todo"

msgid "Choose selected %s"
msgstr "Elegir lo marcado"

msgid "Remove selected %s"
msgstr "Quitar lo marcado"

#, javascript-format
msgid "Chosen %s"
msgstr "Selección de %s"

#, javascript-format
msgid ""
"Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr ""
"Para quitar %s, se marcan en esta lista y se pulsa la flecha «Quitar»."

#, javascript-format
msgid "Type into this box to filter down the list of selected %s."
msgstr "Lo que se escribe en este cuadro filtra la selección de %s."

msgid "Remove all %s"
msgstr "Quitar todo"

#, javascript-format
msgid "%s selected option not visible"
msgid_plural "%s selected options not visible"
msgstr[0] "%s opción elegida no visible"
msgstr[1] "%s opciones elegidas no visibles"
msgstr[2] "%s opciones elegidas no visibles"

msgid "(click to clear)"
msgstr "(clic para quitar el filtro)"
