{
	admin off

	# Timeouts de borde. Sin ellos, Caddy sostiene indefinidamente una conexión lenta y
	# la reenvía a gunicorn, que atiende un número fijo de peticiones a la vez (procesos
	# por hilos, ver backend/gunicorn.conf.py): unas pocas conexiones lentas bastan para
	# ocuparlas todas y tumbar el sitio (slowloris). Con read_body/read_header acotados,
	# Caddy absorbe o corta el cuerpo ANTES de tocar la aplicación.
	#
	# read_body es el plazo de todo el cuerpo: cinco minutos dejan subir un audio de 50 MB
	# con unos 1,4 Mbps de subida. El precio: Caddy reenvía el cuerpo a gunicorn mientras
	# llega, así que una subida lenta ocupa uno de sus hilos todo ese tiempo.
	servers {
		timeouts {
			read_body 5m
			read_header 10s
			write 60s
			idle 120s
		}
	}

	# Logger POR DEFECTO, que es del que cuelga el log de ERRORES. No basta con filtrar
	# el log de acceso del sitio: cuando el upstream falla (un 500, un timeout), Caddy
	# emite una entrada de error que incluye la petición entera, y ahí volvía a aparecer
	# el token del boletín sin redactar. Se comprobó reproduciéndolo.
	#
	# Las rutas con token son las de apps/community/urls.py, y el token también viaja en
	# las cabeceras que repiten la URL de la página: Referer (estáticos, formularios) y
	# Hx-Current-Url (el buscador de htmx). tests/test_caddy_redaction.py comprueba que
	# los dos filtros cubren todas esas rutas.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "/novedades/(confirmar|baja)/[^/?]+" "/novedades/$1/<redactado>"
				request>headers>Referer regexp "/novedades/(confirmar|baja)/[^/?]+" "/novedades/$1/<redactado>"
				request>headers>Hx-Current-Url regexp "/novedades/(confirmar|baja)/[^/?]+" "/novedades/$1/<redactado>"
			}
		}
	}
}

# El sitio se sirve sin www (SITE_URL de Django apunta al mismo dominio). Si el DNS de www
# existe, Caddy obtiene su certificado y redirige a la dirección sin www; si no existe, solo
# registra que no pudo obtenerlo, sin afectar al dominio. En local y en las pruebas
# (":80") este bloque no coincide con ninguna petición.
www.{$SITE_ADDRESS::80} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

# SITE_ADDRESS = dominio real en producción (Caddy obtiene TLS de Let's Encrypt
# automáticamente) o ":80" en local/pruebas (HTTP, sin certificado).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Corta cuerpos de request abusivos en el borde, algo por encima del tope de cada ruta
	# para que quien se pase vea el mensaje del formulario y no un 413 sin cuerpo: el panel
	# sube audio de hasta 50 MB (apps/media/validators.py), y el formulario público, un
	# adjunto de hasta 10 MB. tests/test_upload_limits.py compara estos valores con los topes.
	@panel path /admin/*
	request_body @panel {
		max_size 60MB
	}
	@fuera_del_panel not path /admin/*
	request_body @fuera_del_panel {
		max_size 12MB
	}

	# Medios servidos directamente desde el volumen (cierra A3: MEDIA en producción).
	# OJO: estas respuestas NO pasan por Django, así que ni el SecurityMiddleware ni
	# config.csp las tocan. Las cabeceras se emiten aquí para que un archivo subido
	# desde el panel no pueda ejecutarse como HTML/JS en el origen del sitio (S-01);
	# es la capa que además protege lo ya subido, sin migrar datos.
	handle_path /media/* {
		# El audio de los registros y los PDF de las publicaciones no se sirven desde aquí:
		# los entrega Django solo mientras su pieza está publicada (abajo, X-Accel-Redirect).
		@protegido path /recordings/* /publications/*
		respond @protegido 404
		root * /srv/media
		file_server
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; sandbox"
			Referrer-Policy no-referrer
			X-Frame-Options DENY
		}
	}

	# Estáticos servidos en el BORDE (hallazgo S-27). Antes los servía WhiteNoise dentro
	# de la app, así que cada CSS, cada JS y los ~14 archivos de TinyMCE atravesaban los
	# workers de gunicorn: consumo del recurso más escaso del sistema para devolver
	# ficheros inmutables, y superficie extra para el agotamiento de workers (S-07).
	#
	# Lo que lleva hash del contenido en el nombre (el manifiesto de Django: «site.3f2a9c1b7e4d.css»)
	# se cachea como inmutable y eterno: un cambio de contenido cambia el nombre. Lo demás (la
	# carpeta de TinyMCE, que va sin hash porque su cargador pide sus archivos por ruta relativa)
	# se revalida en cada uso con el ETag: aunque su carpeta lleve la versión, un archivo que
	# cambie sin cambiarla no se queda viejo en la caché del navegador.
	handle_path /static/* {
		root * /srv/static
		@hashed path_regexp [.][0-9a-f]{12}[.][a-z0-9]+$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path_regexp [.][0-9a-f]{12}[.][a-z0-9]+$
		header @unhashed Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		file_server
	}

	# Todo lo demás va a gunicorn. Cuando Django responde con X-Accel-Redirect (el archivo de
	# una pieza publicada, backend/config/protected_media.py), Caddy lo lee del volumen de
	# medios: admite saltos (Range) y gunicorn no ocupa un hilo en enviarlo. Con las mismas
	# cabeceras defensivas que /media/.
	#
	# Las cabeceras de Django no pasan solas a esa respuesta: se copian la de caché (un PDF de
	# dirección fija se revalida en cada uso, para que tras un reemplazo nadie reciba el viejo)
	# y las de la vista previa del equipo (ni se guarda ni se indexa).
	reverse_proxy web:8000 {
		@archivo_publicado header X-Accel-Redirect *
		handle_response @archivo_publicado {
			root * /srv/media
			rewrite * {rp.header.X-Accel-Redirect}
			copy_response_headers {
				include Cache-Control X-Robots-Tag
			}
			file_server
			header {
				X-Content-Type-Options nosniff
				Content-Security-Policy "default-src 'none'; sandbox"
				Referrer-Policy no-referrer
				X-Frame-Options DENY
			}
		}
	}

	header -Server

	# Log de acceso en el BORDE, no en gunicorn (residuo del hallazgo S-20 y del aviso
	# de que el log de gunicorn registraba siempre la IP interna del proxy). Aquí sí se
	# ve la IP real del cliente, y sobre todo se puede REDACTAR: los enlaces del boletín
	# llevan el token en la ruta, así que un log sin filtrar entrega a quien lo lea la
	# capacidad de dar de baja suscripciones ajenas. gunicorn no permitía esto, porque
	# su formato de acceso no admite sustituciones.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "/novedades/(confirmar|baja)/[^/?]+" "/novedades/$1/<redactado>"
				request>headers>Referer regexp "/novedades/(confirmar|baja)/[^/?]+" "/novedades/$1/<redactado>"
				request>headers>Hx-Current-Url regexp "/novedades/(confirmar|baja)/[^/?]+" "/novedades/$1/<redactado>"
			}
		}
	}
}
