{
	admin off

	# Timeouts de borde (hallazgo S-07). Sin ellos, Caddy sostenía indefinidamente una
	# conexión lenta y la reenviaba a gunicorn, que corre con workers de tipo sync: unas
	# pocas conexiones bastaban para ocupar todos los procesos y tumbar el sitio
	# (slowloris). Con read_body/read_header acotados, Caddy absorbe o corta el cuerpo
	# ANTES de tocar la aplicación.
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			write 60s
			idle 120s
		}
	}
}

# SITE_ADDRESS = dominio real en producción (Caddy obtiene TLS de Let's Encrypt
# automáticamente) o ":80" en local/pruebas (HTTP, sin certificado).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Corta cuerpos de request abusivos en el borde (el adjunto de envíos permite
	# 10 MB; el margen cubre la sobrecarga multipart). Defensa antes de llegar a la app.
	request_body {
		max_size 12MB
	}

	# Medios servidos directamente desde el volumen (cierra A3: MEDIA en producción).
	# OJO: estas respuestas NO pasan por Django, así que ni el SecurityMiddleware ni
	# config.csp las tocan. Las cabeceras se emiten aquí para que un archivo subido
	# desde el panel no pueda ejecutarse como HTML/JS en el origen del sitio (S-01);
	# es la capa que además protege lo ya subido, sin migrar datos.
	handle_path /media/* {
		root * /srv/media
		file_server
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; sandbox"
			Referrer-Policy no-referrer
			X-Frame-Options DENY
		}
	}

	# Todo lo demás va a gunicorn; los estáticos los sirve WhiteNoise dentro de la app.
	reverse_proxy web:8000

	header -Server
}
